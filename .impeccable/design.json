    {
      "name": "Google card front",
      "kind": "card",
      "refersTo": "google-card",
      "description": "Normal Google experience front; conditional profile is a separate left aside.",
      "html": "<article class=\"ds-google\"><small>Software Engineer \u00b7 AI Observability</small><h2>Google</h2><p>Understanding how AI systems behave.</p><button>Click to flip \u21b6</button></article>",
      "css": ".ds-google{width:500px;max-width:100%;height:330px;padding:32px 38px;background:#f7f8fa;color:#24282e;box-shadow:6px 30px 65px -25px #000a;display:flex;flex-direction:column;border-bottom:5px solid #4285f4}.ds-google small{font:600 12px \"DM Sans\",sans-serif}.ds-google h2{font:500 64px/.96 \"Space Grotesk\",sans-serif;letter-spacing:-.04em;margin:38px 0 20px}.ds-google p{font:17px/1.5 \"DM Sans\",sans-serif;max-width:38ch;margin:0}.ds-google button{align-self:flex-start;margin-top:auto;border:0;border-bottom:1px solid currentColor;background:none;color:inherit;padding:9px 0;font:600 13px \"DM Sans\",sans-serif;cursor:pointer}.ds-google button:hover{text-decoration:underline}.ds-google button:focus-visible{outline:2px solid var(--accent,#b4c8ff);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{transition:none!important}}"
    },
    {
      "name": "Clarity screenshot controls",
      "kind": "button",
      "refersTo": "project-preview-tab",
      "description": "Net worth, Cash flow, and Investments switch screenshots inside the project card.",
      "html": "<div class=\"ds-project-tabs\" role=\"group\" aria-label=\"Clarity product preview\"><button aria-pressed=\"true\">Net worth</button><button aria-pressed=\"false\">Cash flow</button><button aria-pressed=\"false\">Investments</button></div>",
      "css": ".ds-project-tabs{display:flex;flex-wrap:wrap;gap:7px;background:#d5e6c6;padding:12px}.ds-project-tabs button{border:1px solid #76906c;background:none;color:#294c27;padding:7px 10px;border-radius:4px;font:11px \"DM Sans\",sans-serif;cursor:pointer}.ds-project-tabs button[aria-pressed=true]{background:#294c27;border-color:#294c27;color:#fff}.ds-project-tabs button:focus-visible{outline:2px solid #294c27;outline-offset:5px}"
    },
    {
      "name": "Gallery dock",
      "kind": "nav",
      "refersTo": "gallery-dock",
      "description": "Compact room navigation; the runtime supplies all six experiences.",
      "html": "<nav class=\"ds-dock\" aria-label=\"Choose an experience\"><button aria-label=\"Previous experience\" disabled>\u2190</button><button aria-current=\"true\">Google</button><button>Coursera</button><button aria-label=\"Next experience\">\u2192</button></nav>",
      "css": ".ds-dock{display:inline-flex;align-items:center;gap:7px;padding:8px;border-radius:13px;background:#232630;box-shadow:0 14px 32px #0005}.ds-dock button{border:0;padding:12px;border-radius:6px;background:none;color:#c9cbd6;font:500 12px/1.2 \"DM Sans\",sans-serif;cursor:pointer}.ds-dock button[aria-current=true]{background:var(--accent,#b4c8ff);color:#151923}.ds-dock button:hover:not(:disabled):not([aria-current=true]){background:#ffffff0b;color:#fff}.ds-dock button:disabled{opacity:.32;cursor:default}.ds-dock button:focus-visible{outline:2px solid var(--accent,#b4c8ff);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{transition:none!important}}"
    },
