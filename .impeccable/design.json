      "css": ".ds-picker-label{display:inline-flex;flex-direction:column;gap:8px;font:12px \"DM Sans\",sans-serif;color:#c1bdcb}.ds-picker{background:#232630;color:var(--accent,#b4c8ff);border:0;padding:11px 12px;font:500 14px/1.3 \"DM Sans\",sans-serif;cursor:pointer}.ds-picker:focus-visible{outline:2px solid var(--accent,#b4c8ff);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{transition:none!important}}"
